<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NOC Core User Management</title>
    <style>
        /* CSS Theme Custom Variables Engine Mapping */
        :root {
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border-color: #cbd5e1;
            --card-sub-bg: #f8fafc;
            --header-th: #e2e8f0;
        }

        [data-theme="dark"] {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #475569;
            --card-sub-bg: #334155;
            --header-th: #334155;
        }

        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg-color); color: var(--text-main); margin: 0; padding: 20px; transition: background 0.3s elements, color 0.3s ease; }
        .container { max-width: 1100px; margin: 0 auto; background: var(--card-bg); padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .header-bar { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--border-color); padding-bottom: 20px; margin-bottom: 25px; }
        h1 { color: var(--text-main); margin: 0; font-size: 24px; font-weight: 700; }
        
        /* Action Buttons Layout Definitions */
        .btn-group { display: flex; gap: 10px; align-items: center; }
        .back-btn { background: #475569; color: white; padding: 10px 16px; border-radius: 6px; font-weight: 600; font-size: 14px; text-decoration: none; border: none; cursor: pointer; }
        .theme-toggle-btn { background: #0284c7; color: white; padding: 10px 16px; border-radius: 6px; font-weight: 600; font-size: 14px; border: none; cursor: pointer; }
        .theme-toggle-btn:hover { background: #0369a1; }
        .create-btn { background: #10b981; color: white; padding: 10px 16px; border-radius: 6px; font-weight: 600; font-size: 14px; border: none; cursor: pointer; }
        .create-btn:hover { background: #059669; }

        .card { background: var(--card-sub-bg); border: 1px solid var(--border-color); padding: 20px; border-radius: 6px; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 10px; }
        th, td { padding: 12px; border: 1px solid var(--border-color); text-align: left; color: var(--text-main); }
        th { background: var(--header-th); color: var(--text-main); }
        
        .action-btn { background: #2563eb; color: white; border: none; padding: 6px 12px; border-radius: 4px; font-weight: bold; cursor: pointer; }
        .action-btn:hover { background: #1d4ed8; }
        .form-group { margin-bottom: 15px; }
        label { display: block; font-weight: 600; margin-bottom: 5px; color: var(--text-muted); }
        input, select { width: 100%; padding: 10px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-main); border-radius: 4px; box-sizing: border-box; }
    </style>
</head>
<body>

<div class="container">
    <div class="header-bar">
        <div>
            <h1>User Management Control Console</h1>
            <div style="color: var(--text-muted); font-size: 14px; margin-top: 4px;">Logged in as: <strong>{{ user.full_name }}</strong></div>
        </div>
        <div class="btn-group">
            <button class="theme-toggle-btn" onclick="toggleSystemTheme()">🌓 Switch Theme</button>
            <button class="create-btn" onclick="openCreateModal()">➕ Add New User</button>
            <a href="/" class="back-btn">← Back to Dashboard</a>
        </div>
    </div>

    <div class="card">
        <h3>Operational Accounts Roster</h3>
        <table>
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Username</th>
                    <th>Full Display Name / Team Tag</th>
                    <th>Access Role Authorization</th>
                    <th>Profile Action</th>
                </tr>
            </thead>
            <tbody id="userTableBody"></tbody>
        </table>
    </div>
</div>

<!-- Add New User Modal Structure Component -->
<div id="createUserModal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.5); justify-content:center; align-items:center;">
    <div class="card" style="background: var(--card-bg); width:480px; padding:25px; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,0.25);">
        <h3 style="margin-top:0;">Register New Operations User</h3>
        
        <div class="form-group">
            <label>Username (Login ID)</label>
            <input type="text" id="create_username" placeholder="e.g. johndoe" required>
        </div>
        <div class="form-group">
            <label>Email ID</label>
            <input type="email" id="create_email" placeholder="name@teleglobal.in" required>
        </div>
        <div class="form-group">
            <label>Full Name / Designation</label>
            <input type="text" id="create_full_name" placeholder="John Doe | Senior Engineer" required>
        </div>
        <div class="form-group">
            <label>Employee ID</label>
            <input type="text" id="create_employee_id" placeholder="TG-NOC-104" required>
        </div>
        <div class="form-group">
            <label>Access Role Option</label>
            <select id="create_role">
                <option value="operator">operator (Read-Only Status Logs)</option>
                <option value="admin">admin (Full Global Operations Write-Access)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Initial Authorization Password</label>
            <input type="text" id="create_password" placeholder="Define security access credentials token" required>
        </div>

        <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:20px;">
            <button type="button" onclick="closeCreateModal()" style="background:#cbd5e1; color:#334155; border:none; padding:10px 15px; border-radius:4px; font-weight:bold; cursor:pointer;">Cancel</button>
            <button type="button" onclick="commitNewUserAccount()" style="background:#10b981; color:white; border:none; padding:10px 15px; border-radius:4px; font-weight:bold; cursor:pointer;">Register Account</button>
        </div>
    </div>
</div>

<!-- Edit Profile Management Modal -->
<div id="userModal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.4); justify-content:center; align-items:center;">
    <div class="card" style="background:var(--card-bg); width:450px; padding:25px; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,0.15);">
        <h3 style="margin-top:0;" id="modalTitle">Modify User Profile</h3>
        <input type="hidden" id="edit_user_id">
        
        <div class="form-group">
            <label>Username (Login ID)</label>
            <input type="text" id="edit_username" required>
        </div>
        <div class="form-group">
            <label>Full Display Name / Support Role Tier</label>
            <input type="text" id="edit_full_name" required>
        </div>
        <div class="form-group">
            <label>Access Privilege Level Role</label>
            <select id="edit_role">
                <option value="operator">operator (Read-Only Status Logs)</option>
                <option value="admin">admin (Full Global Operations Write-Access)</option>
            </select>
        </div>
        <div class="form-group" style="background:#fffbeb; border:1px solid #fef3c7; padding:10px; border-radius:4px;">
            <label style="color:#b45309;">Administrative Security Override Password</label>
            <input type="text" id="edit_password" placeholder="Leave blank to preserve current password">
            <small style="color:#64748b; margin-top:4px; display:block;">Enter a new plain text password here to overwrite their existing login password.</small>
        </div>

        <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:20px;">
            <button type="button" onclick="closeUserModal()" style="background:#cbd5e1; color:#334155; border:none; padding:10px 15px; border-radius:4px; font-weight:bold; cursor:pointer;">Cancel</button>
            <button type="button" onclick="commitUserChanges()" style="background:#10b981; color:white; border:none; padding:10px 15px; border-radius:4px; font-weight:bold; cursor:pointer;">Save Changes</button>
        </div>
    </div>
</div>

<script>
// Theme Management Engine Execution Script Loops
const activeThemeSetting = localStorage.getItem('noc-theme') || 'light';
document.documentElement.setAttribute('data-theme', activeThemeSetting);

function toggleSystemTheme() {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const targetedTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', targetedTheme);
    localStorage.setItem('noc-theme', targetedTheme);
}

// User Creation Modal Triggers
function openCreateModal() {
    document.getElementById('create_username').value = '';
    document.getElementById('create_email').value = '';
    document.getElementById('create_full_name').value = '';
    document.getElementById('create_employee_id').value = '';
    document.getElementById('create_password').value = '';
    document.getElementById('createUserModal').style.display = 'flex';
}
function closeCreateModal() { document.getElementById('createUserModal').style.display = 'none'; }

async function commitNewUserAccount() {
    const payload = {
        username: document.getElementById('create_username').value.trim(),
        email_id: document.getElementById('create_email').value.trim(),
        full_name: document.getElementById('create_full_name').value.trim(),
        employee_id: document.getElementById('create_employee_id').value.trim(),
        role: document.getElementById('create_role').value,
        password: document.getElementById('create_password').value
    };

    if(!payload.username || !payload.email_id || !payload.password) {
        alert("Please completely define mandatory attributes: Username, Email, and Password.");
        return;
    }

    try {
        const res = await fetch('/api/admin/users/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if(res.ok) {
            closeCreateModal();
            loadUsersRoster();
        } else {
            const errData = await res.json();
            alert(`Registration Dropped: ${errData.detail}`);
        }
    } catch(err) {
        alert(`Network transmission exception: ${err.message}`);
    }
}

async function loadUsersRoster() {
    try {
        const res = await fetch('/api/admin/users/all');
        const users = await res.json();
        const tbody = document.getElementById('userTableBody');
        tbody.innerHTML = '';
        
        users.forEach(u => {
            tbody.innerHTML += `
            <tr>
                <td><strong>#${u.id}</strong></td>
                <td style="font-family:monospace; font-weight:bold;">${u.username}</td>
                <td>${u.full_name}</td>
                <td>
                    <span style="padding:4px 8px; border-radius:12px; font-size:12px; font-weight:bold; ${u.role === 'admin' ? 'background:#dbeafe; color:#1e40af;' : 'background:#e2e8f0; color:#334155;'}">
                        ${u.role.toUpperCase()}
                    </span>
                </td>
                <td><button type="button" class="action-btn" onclick="openUserModal(${u.id}, '${u.username}', '${u.full_name}', '${u.role}')">Modify Account</button></td>
            </tr>`;
        });
    } catch(e) { console.error("Error generating staff grid profiles: ", e); }
}

function openUserModal(id, username, fullName, role) {
    document.getElementById('edit_user_id').value = id;
    document.getElementById('edit_username').value = username;
    document.getElementById('edit_full_name').value = fullName;
    document.getElementById('edit_role').value = role;
    document.getElementById('edit_password').value = ''; 
    document.getElementById('userModal').style.display = 'flex';
}

function closeUserModal() { document.getElementById('userModal').style.display = 'none'; }

async function commitUserChanges() {
    const payload = {
        user_id: parseInt(document.getElementById('edit_user_id').value),
        username: document.getElementById('edit_username').value,
        full_name: document.getElementById('edit_full_name').value,
        role: document.getElementById('edit_role').value,
        password: document.getElementById('edit_password').value
    };

    try {
        const res = await fetch('/api/admin/users/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if(res.ok) {
            closeUserModal();
            loadUsersRoster();
        } else {
            const data = await res.json();
            alert(`Error updating profile data: ${data.detail}`);
        }
    } catch(err) { alert(`Execution dropped: ${err.message}`); }
}

window.addEventListener('DOMContentLoaded', loadUsersRoster);
</script>
</body>
</html>
