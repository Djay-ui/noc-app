<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NOC Core - User Management Console</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #f1f5f9;
            --card-bg: #ffffff;
            --card-sub-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --header-th: #f8fafc;
            --input-bg: #ffffff;
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --modal-overlay: rgba(15, 23, 42, 0.6);
            --shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        }

        [data-theme="dark"] {
            --bg-color: #0b0f19;
            --card-bg: #111827;
            --card-sub-bg: #1f2937;
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --border-color: #1f2937;
            --header-th: #1f2937;
            --input-bg: #111827;
            --primary: #3b82f6;
            --primary-hover: #2563eb;
            --modal-overlay: rgba(0, 0, 0, 0.75);
            --shadow: 0 4px 25px -2px rgba(0, 0, 0, 0.3);
        }

        * { box-sizing: border-box; }
        body { 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; 
            background: var(--bg-color); 
            color: var(--text-main); 
            margin: 0; 
            padding: 30px 20px; 
            transition: background 0.3s ease, color 0.3s ease; 
        }

        .container { max-width: 1320px; margin: 0 auto; }

        /* Header Bar */
        .header-bar { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-bottom: 25px; 
            background: var(--card-bg);
            padding: 20px 25px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow);
        }
        .header-title h1 { margin: 0; font-size: 22px; font-weight: 700; color: var(--text-main); }
        .header-title .user-meta { color: var(--text-muted); font-size: 13px; margin-top: 4px; display: flex; align-items: center; gap: 6px; }
        
        .btn-group { display: flex; gap: 10px; align-items: center; }
        .btn { 
            display: inline-flex; 
            align-items: center; 
            gap: 8px; 
            padding: 9px 16px; 
            border-radius: 8px; 
            font-weight: 600; 
            font-size: 13px; 
            border: none; 
            cursor: pointer; 
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .back-btn { background: var(--card-sub-bg); color: var(--text-main); border: 1px solid var(--border-color); }
        .back-btn:hover { background: var(--border-color); }
        .theme-toggle-btn { background: var(--card-sub-bg); color: var(--text-main); border: 1px solid var(--border-color); }
        .theme-toggle-btn:hover { background: var(--border-color); }
        .create-btn { background: var(--primary); color: white; }
        .create-btn:hover { background: var(--primary-hover); }

        /* Metrics Grid */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }
        .metric-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 18px 20px;
            border-radius: 12px;
            box-shadow: var(--shadow);
        }
        .metric-card .title { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .metric-card .value { font-size: 26px; font-weight: 700; color: var(--text-main); margin-top: 6px; }

        /* Card Container & Table Search */
        .card { 
            background: var(--card-bg); 
            border: 1px solid var(--border-color); 
            padding: 24px; 
            border-radius: 12px; 
            box-shadow: var(--shadow);
        }
        .table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            gap: 15px;
            flex-wrap: wrap;
        }
        .table-title { font-size: 16px; font-weight: 700; margin: 0; }
        .search-input-wrap { position: relative; width: 300px; }
        .search-input-wrap input {
            width: 100%;
            padding: 9px 12px 9px 36px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--input-bg);
            color: var(--text-main);
            font-size: 13px;
            outline: none;
        }
        .search-input-wrap svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            fill: var(--text-muted);
            width: 16px;
            height: 16px;
        }

        /* Table Styling */
        .table-responsive { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; text-align: left; }
        th { 
            background: var(--header-th); 
            color: var(--text-muted); 
            font-weight: 600; 
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
            padding: 12px 14px; 
            border-bottom: 1px solid var(--border-color); 
        }
        td { padding: 14px; border-bottom: 1px solid var(--border-color); color: var(--text-main); vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: var(--card-sub-bg); }

        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: capitalize;
        }
        .badge-admin { background: rgba(37, 99, 235, 0.12); color: #3b82f6; border: 1px solid rgba(37, 99, 235, 0.2); }
        .badge-operator { background: rgba(100, 116, 139, 0.12); color: var(--text-muted); border: 1px solid rgba(100, 116, 139, 0.2); }
        .badge-pending { background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); }
        .badge-active { background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }

        /* Action Buttons */
        .action-group { display: flex; gap: 6px; align-items: center; }
        .action-btn { 
            background: var(--card-sub-bg); 
            color: var(--text-main); 
            border: 1px solid var(--border-color); 
            padding: 6px 10px; 
            border-radius: 6px; 
            font-weight: 500; 
            font-size: 12px; 
            cursor: pointer; 
            transition: all 0.2s ease;
        }
        .action-btn:hover { border-color: var(--primary); color: var(--primary); }
        .action-btn.reset:hover { border-color: var(--warning); color: var(--warning); }
        .action-btn.delete { color: var(--danger); }
        .action-btn.delete:hover { background: var(--danger); color: white; border-color: var(--danger); }

        /* Modal Overlay & Card */
        .modal-overlay {
            display: none; 
            position: fixed; 
            z-index: 9999; 
            left: 0; 
            top: 0; 
            width: 100%; 
            height: 100%; 
            background: var(--modal-overlay);
            backdrop-filter: blur(4px);
            justify-content: center; 
            align-items: center;
            padding: 20px;
        }
        .modal-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            width: 100%;
            max-width: 500px;
            padding: 28px;
            border-radius: 12px;
            box-shadow: var(--shadow);
            animation: fadeIn 0.2s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .modal-header h3 { margin: 0; font-size: 18px; font-weight: 700; }
        .modal-close { background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer; }

        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-weight: 600; font-size: 12px; margin-bottom: 6px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .form-group input, .form-group select { 
            width: 100%; 
            padding: 10px 12px; 
            border: 1px solid var(--border-color); 
            background: var(--input-bg); 
            color: var(--text-main); 
            border-radius: 8px; 
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s ease;
        }
        .form-group input:focus, .form-group select:focus { border-color: var(--primary); }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .form-override-box {
            background: rgba(245, 158, 11, 0.08); 
            border: 1px dashed rgba(245, 158, 11, 0.4); 
            padding: 12px; 
            border-radius: 8px;
            margin-top: 10px;
        }
        .form-override-box label { color: var(--warning); }

        .modal-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px; }
    </style>
</head>
<body>

<div class="container">
    <!-- Navigation Header -->
    <div class="header-bar">
        <div class="header-title">
            <h1>User Management Console</h1>
            <div class="user-meta">
                <span>Active Operator: <strong>{{ user.full_name }}</strong></span>
            </div>
        </div>
        <div class="btn-group">
            <button class="btn theme-toggle-btn" onclick="toggleSystemTheme()">🌓 Switch Theme</button>
            <button class="btn create-btn" onclick="openCreateModal()">➕ Add New User</button>
            <a href="/" class="btn back-btn">← Back to Dashboard</a>
        </div>
    </div>

    <!-- Summary Metrics Grid -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="title">Total System Users</div>
            <div class="value" id="metricTotalUsers">0</div>
        </div>
        <div class="metric-card">
            <div class="title">Administrators</div>
            <div class="value" id="metricAdmins">0</div>
        </div>
        <div class="metric-card">
            <div class="title">Operators</div>
            <div class="value" id="metricOperators">0</div>
        </div>
        <div class="metric-card">
            <div class="title">First-Login Pending</div>
            <div class="value" id="metricPending">0</div>
        </div>
    </div>

    <!-- Roster Table Card -->
    <div class="card">
        <div class="table-toolbar">
            <h3 class="table-title">Operational Accounts Roster</h3>
            <div class="search-input-wrap">
                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <input type="text" id="rosterSearch" placeholder="Filter roster by keyword..." onkeyup="filterRosterTable()">
            </div>
        </div>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Emp ID</th>
                        <th>Username</th>
                        <th>Email Address</th>
                        <th>Display Name</th>
                        <th>Role</th>
                        <th>First Login</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add New User Modal -->
<div id="createUserModal" class="modal-overlay">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Register New Account</h3>
            <button class="modal-close" onclick="closeCreateModal()">&times;</button>
        </div>
        <div class="form-row">
            <div class="form-group"><label>Username</label><input type="text" id="create_username" required></div>
            <div class="form-group"><label>Employee ID</label><input type="text" id="create_employee_id" required></div>
        </div>
        <div class="form-group"><label>Email Address</label><input type="email" id="create_email" required></div>
        <div class="form-group"><label>Full Name / Designation</label><input type="text" id="create_full_name" required></div>
        <div class="form-row">
            <div class="form-group">
                <label>Access Role</label>
                <select id="create_role">
                    <option value="operator">Operator</option>
                    <option value="admin">Administrator</option>
                </select>
            </div>
            <div class="form-group"><label>Default Password</label><input type="password" id="create_password" required></div>
        </div>
        <div class="modal-footer">
            <button class="btn back-btn" type="button" onclick="closeCreateModal()">Cancel</button>
            <button class="btn create-btn" type="button" onclick="commitNewUserAccount()">Create Account</button>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div id="userModal" class="modal-overlay">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Modify Account Details</h3>
            <button class="modal-close" onclick="closeUserModal()">&times;</button>
        </div>
        <input type="hidden" id="edit_user_id">
        <div class="form-row">
            <div class="form-group"><label>Username</label><input type="text" id="edit_username" required></div>
            <div class="form-group"><label>Employee ID</label><input type="text" id="edit_employee_id" required></div>
        </div>
        <div class="form-group"><label>Email Address</label><input type="email" id="edit_email" required></div>
        <div class="form-group"><label>Full Name / Designation</label><input type="text" id="edit_full_name" required></div>
        <div class="form-group">
            <label>Access Role</label>
            <select id="edit_role">
                <option value="operator">Operator</option>
                <option value="admin">Administrator</option>
            </select>
        </div>
        <div class="form-override-box">
            <div class="form-group" style="margin-bottom:0;">
                <label>Administrative Password Override</label>
                <input type="password" id="edit_password" placeholder="Leave blank to maintain current password">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn back-btn" type="button" onclick="closeUserModal()">Cancel</button>
            <button class="btn create-btn" type="button" onclick="commitUserChanges()">Save Changes</button>
        </div>
    </div>
</div>

<script>
let globalRosterData = [];

// Helper function to safely check pending status across various JSON field variations
function checkIsPending(user) {
    if (!user || typeof user !== 'object') return false;
    const val = user.is_first_login ?? user.first_login ?? user.isFirstLogin;
    return val === true || val === 1 || val === "1" || val === "true";
}

// Dynamic Theme Management
const activeThemeSetting = localStorage.getItem('noc-theme') || 'dark';
document.documentElement.setAttribute('data-theme', activeThemeSetting);

function toggleSystemTheme() {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const targetedTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', targetedTheme);
    localStorage.setItem('noc-theme', targetedTheme);
}

// Modal Handlers
function openCreateModal() {
    document.getElementById('create_username').value = '';
    document.getElementById('create_email').value = '';
    document.getElementById('create_full_name').value = '';
    document.getElementById('create_employee_id').value = '';
    document.getElementById('create_password').value = '';
    document.getElementById('createUserModal').style.display = 'flex';
}
function closeCreateModal() { document.getElementById('createUserModal').style.display = 'none'; }

function openUserModal(id) {
    // Lookup user in state array by ID to avoid string escape issues
    const user = globalRosterData.find(u => u.id === id);
    if (!user) return;

    document.getElementById('edit_user_id').value = user.id;
    document.getElementById('edit_username').value = user.username || '';
    document.getElementById('edit_email').value = user.email_id || '';
    document.getElementById('edit_full_name').value = user.full_name || '';
    document.getElementById('edit_employee_id').value = user.employee_id || '';
    document.getElementById('edit_role').value = user.role || 'operator';
    document.getElementById('edit_password').value = ''; 
    document.getElementById('userModal').style.display = 'flex';
}
function closeUserModal() { document.getElementById('userModal').style.display = 'none'; }

// Roster Loader & Renderer
async function loadUsersRoster() {
    try {
        const response = await fetch('/api/admin/users/all');
        if (!response.ok) throw new Error('Failed to fetch user list');
        
        globalRosterData = await response.json();
        updateSummaryMetrics(globalRosterData);
        renderRosterTable(globalRosterData);
    } catch (error) {
        console.error("Error loading user roster:", error);
    }
}

function updateSummaryMetrics(users) {
    document.getElementById('metricTotalUsers').innerText = users.length;
    document.getElementById('metricAdmins').innerText = users.filter(u => u.role === 'admin').length;
    document.getElementById('metricOperators').innerText = users.filter(u => u.role === 'operator').length;
    
    const pendingCount = users.filter(u => checkIsPending(u)).length;
    document.getElementById('metricPending').innerText = pendingCount;
}

function renderRosterTable(users) {
    const tbody = document.getElementById('usersTableBody');
    tbody.innerHTML = '';

    if (!users || users.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; color: var(--text-muted); padding:20px;">No operational accounts found.</td></tr>`;
        return;
    }

    users.forEach(user => {
        const row = document.createElement('tr');
        
        const roleBadge = user.role === 'admin' 
            ? `<span class="badge badge-admin">Admin</span>` 
            : `<span class="badge badge-operator">Operator</span>`;

        const isPending = checkIsPending(user);
        const firstLoginBadge = isPending 
            ? `<span class="badge badge-pending">⚠️ Pending</span>` 
            : `<span class="badge badge-active">Active</span>`;

        row.innerHTML = `
            <td><strong>#${user.id}</strong></td>
            <td>${user.employee_id || '-'}</td>
            <td><strong>${user.username}</strong></td>
            <td>${user.email_id || '-'}</td>
            <td>${user.full_name || '-'}</td>
            <td>${roleBadge}</td>
            <td>${firstLoginBadge}</td>
            <td style="text-align: right;">
                <div class="action-group" style="justify-content: flex-end;">
                    <button class="action-btn" onclick="openUserModal(${user.id})" title="Edit User">✏️ Edit</button>
                    <button class="action-btn reset" onclick="resetUserFirstLogin(${user.id})" title="Force password reset on next login">🔄 Reset</button>
                    <button class="action-btn delete" onclick="triggerAccountDeletion(${user.id}, '${user.username}')" title="Delete User">🗑️</button>
                </div>
            </td>
        `;
        tbody.appendChild(row);
    });
}

function filterRosterTable() {
    const query = document.getElementById('rosterSearch').value.toLowerCase();
    const filtered = globalRosterData.filter(user => {
        return (
            (user.username && user.username.toLowerCase().includes(query)) ||
            (user.full_name && user.full_name.toLowerCase().includes(query)) ||
            (user.email_id && user.email_id.toLowerCase().includes(query)) ||
            (user.employee_id && user.employee_id.toLowerCase().includes(query)) ||
            (user.role && user.role.toLowerCase().includes(query))
        );
    });
    renderRosterTable(filtered);
}

// API Actions
async function commitNewUserAccount() {
    const payload = {
        username: document.getElementById('create_username').value.trim(),
        email_id: document.getElementById('create_email').value.trim(),
        full_name: document.getElementById('create_full_name').value.trim(),
        employee_id: document.getElementById('create_employee_id').value.trim(),
        role: document.getElementById('create_role').value,
        password: document.getElementById('create_password').value
    };
    try {
        const res = await fetch('/api/admin/users/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if(res.ok) { closeCreateModal(); loadUsersRoster(); } 
        else { const err = await res.json(); alert(`Error: ${err.detail}`); }
    } catch(err) { alert(`Transmission failure: ${err.message}`); }
}

async function commitUserChanges() {
    const payload = {
        user_id: parseInt(document.getElementById('edit_user_id').value),
        username: document.getElementById('edit_username').value.trim(),
        email_id: document.getElementById('edit_email').value.trim(),
        full_name: document.getElementById('edit_full_name').value.trim(),
        employee_id: document.getElementById('edit_employee_id').value.trim(),
        role: document.getElementById('edit_role').value,
        password: document.getElementById('edit_password').value
    };
    try {
        const res = await fetch('/api/admin/users/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if(res.ok) { 
            closeUserModal(); 
            loadUsersRoster(); // Refreshes the roster automatically upon update
        } else { 
            const data = await res.json(); 
            alert(`Error: ${data.detail}`); 
        }
    } catch(err) { alert(`Execution error: ${err.message}`); }
}

async function triggerAccountDeletion(id, username) {
    if(!confirm(`WARNING: Are you sure you want to delete user "${username}"?`)) return;
    try {
        const res = await fetch(`/api/admin/users/delete/${id}`, { method: 'POST' });
        if(res.ok) { loadUsersRoster(); } 
        else { const data = await res.json(); alert(`Error: ${data.detail}`); }
    } catch(err) { alert(`Delete transmission dropped: ${err.message}`); }
}

async function resetUserFirstLogin(userId) {
    if (!confirm("Force this user to change their password on their next login?")) return;

    try {
        const response = await fetch(`/api/admin/users/force-password-reset/${userId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();
        if (response.ok) {
            alert(data.message);
            loadUsersRoster();
        } else {
            alert(`Error: ${data.detail}`);
        }
    } catch (error) {
        alert(`Network Error: ${error.message}`);
    }
}

window.addEventListener('DOMContentLoaded', loadUsersRoster);
</script>
</body>
</html>
