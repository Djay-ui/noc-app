<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>TeleGlobal SR Resolution Email</title>
  <style type="text/css">
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    table { border-collapse: collapse !important; }
    body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #f5f5f5; }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; font-family: 'Segoe UI', Inter, Helvetica, Arial, sans-serif;">

  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f5f5f5; padding: 24px 10px;">
    <tr>
      <td align="center" valign="top">
        
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 650px; background-color: #ffffff; border: 1px solid #d0d0d0; border-radius: 6px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
          
          <!-- BEAUTIFUL GRADIENT HEADER WITH LOGO BOX -->
          <tr>
            <td bgcolor="#0a3d52" style="background: #0a3d52 linear-gradient(135deg, #0a3d52 0%, #0e6679 40%, #0a8a9f 70%); padding: 24px; text-align: left;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td width="60" valign="middle" style="padding-right: 14px;">
                    <svg width="50" height="50" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                      <circle cx="26" cy="26" r="24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1"></circle>
                      <circle cx="26" cy="26" r="16" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"></circle>
                      <circle cx="26" cy="20" r="6" fill="#4fc3d8" opacity="0.9"></circle>
                      <circle cx="18" cy="30" r="4" fill="#7adde8" opacity="0.8"></circle>
                      <circle cx="34" cy="30" r="4" fill="#7adde8" opacity="0.8"></circle>
                      <line x1="26" y1="20" x2="18" y2="30" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"></line>
                      <line x1="26" y1="20" x2="34" y2="30" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"></line>
                      <line x1="18" y1="30" x2="34" y2="30" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"></line>
                      <circle cx="26" cy="20" r="2.5" fill="#ffffff"></circle>
                      <circle cx="18" cy="30" r="2" fill="#ffffff"></circle>
                      <circle cx="34" cy="30" r="2" fill="#ffffff"></circle>
                    </svg>
                  </td>
                  <td valign="middle">
                    <div style="font-size: 24px; font-weight: 700; color: #ffffff; line-height: 1.1; letter-spacing: -0.3px;">TeleGlobal</div>
                    <div style="font-size: 13px; color: #cceaf0; font-weight: 400; margin-top: 1px;">Communications Pvt. Ltd.</div>
                    <div style="font-size: 11px; color: #a8dce8; font-style: italic; margin-top: 4px;">Reliable Connectivity. Assured Performance.</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding: 24px 24px 16px 24px;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td valign="top" style="font-size: 14px; color: #1a1a1a; line-height: 1.5;">
                    <p style="margin: 0 0 8px 0; font-weight: 700; font-size: 15px;">Dear Customer,</p>
                    <p style="margin: 0 0 6px 0;">Greetings from <span style="font-weight: 700; color: #006e7f;">TeleGlobal Communications Pvt. Ltd.</span></p>
                    <p style="margin: 0 0 6px 0;">We truly appreciate your trust in us.</p>
                    <p style="margin: 0 0 6px 0;">As informed earlier, your service request has been successfully resolved.</p>
                    <p style="margin: 0 0 16px 0;">Please find the complete operational summary and resolution analysis below:</p>
                  </td>
                </tr>
                <tr>
                  <td style="padding-bottom: 20px;">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border: 2px solid #2db85c; border-radius: 6px; background-color: #ffffff;">
                      <tr>
                        <td width="55" valign="middle" style="padding: 14px 0 14px 16px;">
                          <table border="0" cellpadding="0" cellspacing="0" bgcolor="#2db85c" style="border-radius: 50%; width: 36px; height: 36px; text-align: center;">
                            <tr>
                              <td valign="middle" style="font-size: 20px; color: #ffffff; font-weight: bold; text-align: center;">&#10003;</td>
                            </tr>
                          </table>
                        </td>
                        <td valign="middle" style="padding: 14px 16px; font-family: sans-serif;">
                          <div style="font-size: 16px; font-weight: 700; color: #2db85c; letter-spacing: 0.5px;">RESOLVED</div>
                          <div style="font-size: 12px; color: #444444; margin-top: 2px; line-height: 1.3;">Thank you for your patience. We are glad to be of service.</div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding: 0 24px;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td bgcolor="#0a4a5e" align="center" style="color: #ffffff; font-size: 12px; font-weight: 700; letter-spacing: 0.8px; padding: 10px 16px; text-transform: uppercase; border-radius: 4px 4px 0 0;">
                    SERVICE REQUEST (SR) DETAILS &amp; RESOLUTION SUMMARY
                  </td>
                </tr>
                <tr>
                  <td>
                    <table border="0" cellpadding="8" cellspacing="0" width="100%" style="border-left: 1px solid #c8c8c8; border-right: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-size: 13px; color: #222222;">
                      <tr>
                        <td width="28%" bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">👤 Customer Name</td>
                        <td width="22%" bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ customer_name }}</td>
                        <td width="26%" bgcolor="#f9fbfc" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">Circuit ID</td>
                        <td width="24%" bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ circuit_id }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">📍 Circuit Location</td>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ circuit_location }}</td>
                        <td bgcolor="#ffffff" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">Circuit Bandwidth</td>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ bandwidth }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">🎫 SR Number / Ticket ID</td>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ ticket_id }}</td>
                        <td bgcolor="#f9fbfc" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">SR Type / Category</td>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ er_type }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">👁️ Reference Ticket ID</td>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ reference_ticket_id }}</td>
                        <td bgcolor="#ffffff" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">SR Priority</td>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ priority }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">📅 SR Creation Time</td>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ creation_time }}</td>
                        <td bgcolor="#f9fbfc" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">SR Resolution Time</td>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ resolution_time }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">🕒 Total Resolution Time</td>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ total_resolution_time }}</td>
                        <td bgcolor="#ffffff" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">Circuit Up Time</td>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ circuit_up_time }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">
                          ⏸️ 'On-hold' Duration
                          <div style="font-size: 10px; color: #666666; font-weight: normal;">(Awaiting Customer Inputs)</div>
                        </td>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ on_hold_duration }}</td>
                        <td bgcolor="#f9fbfc" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">SR Reopen Case (Y/N)</td>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ roopen_case }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">
                          ❌ Nature of Fault
                          <div style="font-size: 10px; color: #666666; font-weight: normal;">(What was the issue?)</div>
                        </td>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ nature_of_fault }}</td>
                        <td bgcolor="#ffffff" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">
                          Reason for Outage
                          <div style="font-size: 10px; color: #666666; font-weight: normal;">(Why did it happen?)</div>
                        </td>
                        <td bgcolor="#ffffff" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ reason_for_outage }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">
                          📍 Issue Location
                          <div style="font-size: 10px; color: #666666; font-weight: normal;">(Where did it happen?)</div>
                        </td>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ issue_location }}</td>
                        <td bgcolor="#f9fbfc" style="border-left: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; font-weight: 600; color: #1a1a1a;">
                          Resolution
                          <div style="font-size: 10px; color: #666666; font-weight: normal;">(How was it resolved?)</div>
                        </td>
                        <td bgcolor="#f9fbfc" style="border-bottom: 1px solid #c8c8c8; color: #444444;">{{ resolution }}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#ffffff" style="font-weight: 600; color: #1a1a1a;">💬 Remarks / Additional Info</td>
                        <td colspan="3" bgcolor="#ffffff" style="color: #444444; line-height: 1.4;">{{ remarks }}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding: 20px 24px 10px 24px; font-size: 13px; color: #444444; line-height: 1.5;">
              <p style="margin: 0 0 6px 0;">Thank you for your patience while we worked to restore your services.</p>
              <p style="margin: 0;">We remain committed to ensuring smooth connectivity for your business.</p>
            </td>
          </tr>

          <tr>
            <td style="padding: 0 24px 20px 24px; font-size: 13px; color: #444444;">
              <p style="margin: 0;">Warm regards,</p>
              <p style="margin: 2px 0 0 0; color: #006e7f; font-weight: 700; font-size: 14px;">TeleGlobal NOC Team</p>
            </td>
          </tr>

          <tr>
            <td style="padding: 0 24px 24px 24px;">
              <table border="0" cellpadding="12" cellspacing="0" width="100%" style="border: 1px solid #d0d0d0; border-radius: 6px; font-size: 12px; color: #444444; line-height: 1.4;">
                <tr>
                  <td width="50%" valign="top" style="border-bottom: 1px solid #eeeeee; border-right: 1px solid #eeeeee;">
                    <strong style="color: #1a1a1a; font-size: 13px;">📞 24x7 NOC Support</strong><br />
                    020 4852 2500<br />+91 85558 11141
                  </td>
                  <td width="50%" valign="top" style="border-bottom: 1px solid #eeeeee;">
                    <strong style="color: #1a1a1a; font-size: 13px;">✉️ Email Support</strong><br />
                    noc@teleglobal.in
                  </td>
                </tr>
                <tr>
                  <td valign="top" style="border-right: 1px solid #eeeeee;">
                    <strong style="color: #1a1a1a; font-size: 13px;">🌐 Website</strong><br />
                    www.teleglobal.com
                  </td>
                  <td valign="top">
                    <strong style="color: #1a1a1a; font-size: 13px;">🏢 Registered Office</strong><br />
                    Cerebrum IT Park, B3, Kalyani Nagar, Pune - 411014, India
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td bgcolor="#0a3d52" align="center" style="color: #cce6ef; font-size: 11px; padding: 16px 20px; line-height: 1.5;">
              <div style="margin-bottom: 2px;">This is an automated notification dispatch. Please do not reply directly to this mail string.</div>
              <div>&copy; {{ current_year }} TeleGlobal Communications Pvt. Ltd. All Rights Reserved.</div>
            </td>
          </tr>

        </table>
        
      </td>
    </tr>
  </table>

</body>
</html>
