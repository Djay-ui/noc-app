<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            color: #111111;
            line-height: 1.6;
        }
        ol {
            margin-top: 10px;
            margin-bottom: 20px;
            padding-left: 20px;
        }
        li {
            margin-bottom: 6px;
        }
    </style>
</head>
<body>
    <div>
        <ol>
        {% for item in update_items %}
            <li>{{ item }}</li>
        {% endfor %}
        </ol>
    </div>
</body>
</html>
