<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Network Incident Notification</title>
</head>
<body style="margin:0;padding:0;background:#f8fafc;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f8fafc">
<tr>
<td align="center" style="padding:40px 15px;">
<table width="700" cellpadding="0" cellspacing="0" style="max-width:700px;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 10px 25px rgba(15,76,129,0.08);border:1px solid #e2e8f0;">
    
    <!-- Top Brand Accent Bar -->
    <tr>
        <td height="6" style="background:linear-gradient(90deg, #0f4c81 0%, #1e88e5 100%);"></td>
    </tr>

    <!-- Header -->
    <tr>
        <td bgcolor="#ffffff" style="padding:32px 40px 24px 40px;border-bottom:1px solid #f1f5f9;">
            <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                    <td>
                        <span style="font-size:11px;font-weight:800;color:#0f4c81;text-transform:uppercase;letter-spacing:1.5px;background:#e0f2fe;padding:5px 10px;border-radius:4px;display:inline-block;margin-bottom:10px;">
                            Incident Alert System
                        </span>
                        <h2 style="color:#0f172a;margin:0;font-size:24px;font-weight:800;letter-spacing:-0.5px;line-height:1.3;">
                            Network Incident Notification
                        </h2>
                        <p style="color:#64748b;font-size:13px;margin:6px 0 0 0;font-weight:500;">
                            Teleglobal Network Operations Center (NOC)
                        </p>
                    </td>
                    <td align="right" valign="top">
                        <table cellpadding="0" cellspacing="0">
                            <tr>
                                <td bgcolor="#fef2f2" style="border:1px solid #fecaca;font-size:11px;font-weight:700;color:#dc2626;padding:6px 14px;border-radius:20px;letter-spacing:0.5px;">
                                    ● CRITICAL DOWN
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <!-- Body Content -->
    <tr>
        <td style="padding:35px 40px 20px 40px;color:#334155;font-size:15px;line-height:28px;">
            Dear Sir/Madam,
            <br><br>
            We sincerely apologize for the inconvenience caused. Our automated advanced monitoring system has detected that your primary network link is currently <strong style="color:#dc2626;background:#fef2f2;padding:2px 6px;border-radius:4px;">unavailable</strong>.
            <br><br>
            A high-priority support ticket has been instantly registered and assigned to our specialized Network Operations Team for immediate troubleshooting, isolation, and resolution.
        </td>
    </tr>

    <!-- TAT & Action Request Box -->
    <tr>
        <td style="padding:0 40px 25px;">
            <table width="100%" cellpadding="18" cellspacing="0" style="background:#fffbeb;border:1px solid #fde68a;border-left:5px solid #d97706;border-radius:6px;font-size:14px;color:#92400e;">
                <tr>
                    <td>
                        <div style="font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:0.5px;color:#b45309;margin-bottom:4px;">
                            ⚡ Target Resolution Time (TAT)
                        </div>
                        <span style="font-size:18px;color:#78350f;font-weight:bold;">2 Hours</span>
                        <div style="font-size:13px;color:#92400e;margin-top:6px;line-height:20px;">
                            To fast-track restoration, kindly verify the physical power status of the network hardware installed at your premises.
                        </div>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <!-- Complaint Details Table -->
    <tr>
        <td style="padding:0 40px 30px;">
            <div style="font-size:13px;font-weight:700;color:#0f4c81;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;">
                📋 Incident Metadata
            </div>
            <table width="100%" cellpadding="12" cellspacing="0" style="border-collapse:collapse;border:1px solid #e2e8f0;border-radius:6px;overflow:hidden;font-size:14px;">
                <tr bgcolor="#f8fafc">
                    <td width="35%" style="border-bottom:1px solid #e2e8f0;color:#64748b;font-weight:600;">Customer Name</td>
                    <td style="border-bottom:1px solid #e2e8f0;color:#0f172a;font-weight:700;">{customer_name}</td>
                </tr>
                <tr>
                    <td style="border-bottom:1px solid #e2e8f0;color:#64748b;font-weight:600;">Circuit ID</td>
                    <td style="border-bottom:1px solid #e2e8f0;color:#0f172a;font-weight:700;font-family:monospace;font-size:15px;">{circuit_id}</td>
                </tr>
                <tr bgcolor="#f8fafc">
                    <td style="border-bottom:1px solid #e2e8f0;color:#64748b;font-weight:600;">Ticket Number</td>
                    <td style="border-bottom:1px solid #e2e8f0;color:#0f4c81;font-weight:700;font-family:monospace;font-size:15px;">{ticket_id}</td>
                </tr>
                <tr>
                    <td style="color:#64748b;font-weight:600;">Issue Reported</td>
                    <td><span style="background:#fef2f2;color:#dc2626;padding:3px 8px;border-radius:4px;font-weight:700;font-size:12px;">LINK DOWN</span></td>
                </tr>
            </table>
        </td>
    </tr>

    <!-- Closing Remarks -->
    <tr>
        <td style="padding:0 40px 25px;font-size:15px;color:#334155;line-height:26px;">
            Our engineers are actively working on this. If you have any emergency inputs to share or require further assistance, please reach out immediately.
            <br><br>
            Best Regards,
        </td>
    </tr>

    <!-- Compact Professional Signature Block (Harmonized Premium Blue Theme) -->
    <tr>
        <td style="padding: 0; background: #f8fafc;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="table-layout: fixed; border-top: 2px solid #0f4c81;">
                <tr>
                    <!-- Left Panel (Branding) -->
                    <td width="190" valign="middle" style="background: #0f4c81; padding: 16px 14px; color: #ffffff;">
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td>
                                    <div style="font-size: 15px; font-weight: bold; color: #ffffff; line-height: 1.1;">TELEGLOBAL</div>
                                    <div style="font-size: 7.5px; color: #cbd5e1; letter-spacing: 1px; font-weight: bold; margin-top: 2px;">COMMUNICATIONS PVT LTD</div>
                                    
                                    <div style="margin-top: 12px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.2);">
                                        <div style="font-size: 11px; font-weight: bold; line-height: 1.1; color: #ffffff;">24x7 NOC CENTER</div>
                                        <div style="font-size: 9px; color: #cbd5e1; margin-top: 2px;">Always Monitoring</div>
                                    </div>
                                    
                                    <div style="margin-top: 10px;">
                                        <span style="font-size: 8.5px; font-weight: bold; background: rgba(0,0,0,0.25); padding: 3px 8px; border-radius: 3px; display: inline-block;">
                                            🟢 NOC: <span style="color: #86efac;">ONLINE</span>
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                    
                    <!-- Right Panel -->
                    <td valign="top" style="padding: 16px 20px; color: #1e293b; background: #ffffff;">
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td valign="top">
                                    <div style="font-size: 15px; font-weight: 800; text-transform: uppercase; color: #0f4c81; line-height: 1.2;">{operator_name}</div>
                                    <div style="font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase; margin-top: 3px;">Network Operation Team (NOC)</div>
                                </td>
                                <td valign="top" align="right" width="125">
                                    <div style="border: 1px solid #bae6fd; background: #f0f9ff; padding: 4px 8px; border-radius: 4px; text-align: center; font-size: 9px; font-weight: 700;">
                                        <span style="color: #0369a1;">24x7x365 SUPPORT</span>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        
                        <!-- Structured Contact Info Grid -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 11px; line-height: 1.6; margin-top: 10px; border-top: 1px solid #f1f5f9; padding-top: 10px;">
                            <tr>
                                <td width="50%" valign="top" style="color: #334155; padding-bottom: 4px;">
                                    <span style="color: #0f4c81; font-size: 12px;">✉</span> <a href="mailto:noc@teleglobal.in" style="color: #0f4c81; text-decoration: none; font-weight: 600;">noc@teleglobal.in</a>
                                </td>
                                <td width="50%" valign="top" style="color: #334155; padding-bottom: 4px;">
                                    <span style="color: #0f4c81; font-size: 12px;">📱</span> <span style="font-weight: 600;">+91 8855811141</span>
                                </td>
                            </tr>
                            <tr>
                                <td width="50%" valign="top" style="color: #334155;">
                                    <span style="color: #0f4c81; font-size: 12px;">🌐</span> <a href="http://www.teleglobals.com" style="color: #0f4c81; text-decoration: none; font-weight: 600;">www.teleglobals.com</a>
                                </td>
                                <td width="50%" valign="top" style="color: #334155;">
                                    <span style="color: #0f4c81; font-size: 12px;">📍</span> <span style="font-weight: 500;">Cerebrum IT Park B3, Pune</span>
                                </td>
                            </tr>
                        </table>
                        
                        <!-- Action Buttons -->
                        <table cellpadding="0" cellspacing="0" border="0" style="margin-top: 12px;">
                            <tr>
                                <td align="center" bgcolor="#0f4c81" style="border-radius: 4px;">
                                    <a href="https://www.teleglobals.com" target="_blank" style="font-size: 9.5px; font-family: Arial, sans-serif; font-weight: 700; color: #ffffff; text-decoration: none; padding: 6px 12px; border-radius: 4px; display: inline-block;">VISIT WEBSITE</a>
                                </td>
                                <td width="8" style="font-size: 1px; line-height: 1px;">&nbsp;</td>
                                <td align="center" bgcolor="#2563eb" style="border-radius: 4px;">
                                    <a href="mailto:noc@teleglobal.in" style="font-size: 9.5px; font-family: Arial, sans-serif; font-weight: 700; color: #ffffff; text-decoration: none; padding: 6px 12px; border-radius: 4px; display: inline-block;">RAISE TICKET</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                
                <!-- Services Bar -->
                <tr>
                    <td colspan="2" style="background: #083055; color: #ffffff; padding: 6px 10px; font-size: 8.5px; font-weight: 700; text-align: center; letter-spacing: 0.3px;">
                        SERVICES: DEDICATED INTERNET &nbsp;|&nbsp; MPLS VPN &nbsp;|&nbsp; SD-WAN &nbsp;|&nbsp; CLOUD CONNECT &nbsp;|&nbsp; DATA CENTER &nbsp;|&nbsp; SECURITY
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    <!-- Email Footer Banner -->
    <tr>
        <td align="center" style="background-color: #0f4c81; padding: 18px 30px; text-align: center; color: #ffffff; font-size: 12px; line-height: 18px; font-weight: 400; letter-spacing: 0.2px;">
            This is an automated operational notification generated by the Teleglobal Network Monitoring Framework.<br>
            Please do not reply directly to this mail system.
        </td>
    </tr>

    <!-- Bottom Disclaimer -->
    <tr>
        <td style="padding: 12px 15px; font-size: 8.5px; color: #64748b; line-height: 1.4; background: #f8fafc; text-align: center; border-top: 1px solid #e2e8f0;">
            Confidential notification for intended recipient only. <b style="color: #0f4c81;">ISO 27001:2013 Certified Company</b>
        </td>
    </tr>
</table>
</td>
</tr>
</table>

</body>
</html>
